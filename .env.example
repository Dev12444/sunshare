# ─── Rahi: database ────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:pass@host/sunshare?sslmode=require"

# ─── Maansi/Diya: where the frontend looks for things ──────────────────────
NEXT_PUBLIC_ENGINE_URL="http://localhost:8000"
NEXT_PUBLIC_ENGINE_WS="ws://localhost:8000/ws"
NEXT_PUBLIC_USE_MOCKS="true"          # flip to false in the H16 integration window
NEXT_PUBLIC_CHAIN_EXPLORER="https://amoy.polygonscan.com"

# ─── Rahi: session + chain ────────────────────────────────────────────────
SESSION_SECRET="change-me-at-h0"
RPC_URL="http://127.0.0.1:8545"        # Hardhat local; Amoy URL for the demo
RELAYER_PRIVATE_KEY=""                 # funded demo wallet, NEVER a real key
CHAIN_ID="31337"
ESCROW_ADDRESS=""
COMMUNITY_POOL_ADDRESS=""

# ─── Diya: web push ───────────────────────────────────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:team@sunshare.local"

# ─── Dev: engine ──────────────────────────────────────────────────────────
# AI broker — set EITHER key, or neither (rule-based fallback still works).
LLM_PROVIDER="auto"                     # auto | anthropic | openai | none
ANTHROPIC_API_KEY=""
BROKER_MODEL="claude-sonnet-5"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
SIM_SPEED="60"                          # sim minutes per real second
SIM_SEED="2026"
DEMO_LAT="23.2156"
DEMO_LNG="72.6369"
ALLOWED_ORIGINS="http://localhost:3000"
