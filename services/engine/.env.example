SIM_SPEED=1
SIM_SEED=2026
WEATHER_MODE=auto
DEMO_LAT=23.2156
DEMO_LNG=72.6369
ALLOWED_ORIGINS=http://localhost:3000

# AI broker. Set EITHER key — or neither, in which case the broker uses its
# rule-based fallback and everything still works.
# LLM_PROVIDER: auto (default) | anthropic | openai | none
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
BROKER_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
BROKER_TIMEOUT_SECONDS=12
